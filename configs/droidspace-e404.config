# Kernel configurations for DroidSpaces on the e404 staging-bpf base
# (kvsnr113/xiaomi_sm8250_kernel_e404, branch staging-bpf, kernel 4.19.404-R)
# Diferencas vs configs/droidspaces.config:
#   - sem LRU_GEN: backport MGLRU ainda nao portado para esta base
#   - zram default compressor via CONFIG_ZRAM_DEF_COMP (e404 usa esse mecanismo)
# KernelSU-Next (submodule rsuntk/KernelSU pin do e404), ntsync e BPF a16/a17
# ja sao nativos nesta base.

# IPC mechanisms
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# Seccomp support
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups support
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# CONFIG_MEMCG is not set
# (mm/memcontrol.c 4.19 nao compila contra os headers cgroup 5.10-grafted
#  do e404; o defconfig dele ja desliga MEMCG - port inviavel por ora;
#  DroidSpaces continua com cgroup device/pids + namespaces)
CONFIG_CGROUP_SCHED=y
# CONFIG_FAIR_GROUP_SCHED is not set
# (kernel/sched/fair.c do e404 tem caminho FAIR_GROUP_SCHED quebrado:
#  usa p->__state/TASK_NEW que nao existem no 4.19; defconfig ja desliga)
CONFIG_CGROUP_FREEZER=y
# CONFIG_CGROUP_NET_PRIO is not set
# (e404 5.10-graft nao compila o caminho netprio: css->cgroup->id quebra;
#  nao e necessario para o DroidSpaces, que usa netns/veth/nft/nat)

# io_uring (backport v5.1 via patches-e404/io_uring)
CONFIG_IO_URING=y

# DMA-BUF heaps desabilitados/ausentes nesta base: QTI allocator-service
# detecta /dev/dma_heap e troca o backend de ion -> dma-buf heaps, quebrando
# alocacao YUV (0x17) no video. O e404 nao tem o driver dma-buf heaps.

# zram/zswap compression backends (LZ4 + LZ4HC; ZSTD default)
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSMALLOC_STAT=y
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set
# (zram_drv.c do e404 traz bloco CONFIG_ZRAM_WRITEBACK de 5.x com block API
#  nova - blkdev_get_by_dev/BLK_OPEN_* - que nao existe no 4.19; sem eles o
#  e404 usa a implementacao 4.19 compativel)
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"

# Device filesystem support
CONFIG_DEVTMPFS=y

# Overlay filesystem support (required for volatile mode)
CONFIG_OVERLAY_FS=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NT synchronization primitives (Wine/Proton) - nativo no e404
CONFIG_NTSYNC=y

# KernelSU-Next (submodule rsuntk/KernelSU do e404, LSM hooks + manual hooks)
CONFIG_KSU=y

# Firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Droidspaces Network Isolation Support - NAT/none modes
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy compat
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# Disable this on older kernels to make internet work
CONFIG_ANDROID_PARANOID_NETWORK=n
