From: Pulsar Bot <pulsar@localhost>
Subject: [PATCH] mm/zswap: add zstd as selectable compressor

The e404 base has ZSWAP with hardcoded LZO. This patch adds
CONFIG_ZSWAP_COMPRESSOR_ZSTD to optionally use zstd as the default
compressor. zstd gives ~20% better compression ratio vs lzo at
comparable decompression speed on SM8250 (POCO F3/alioth).

Set CONFIG_ZSWAP_COMPRESSOR_ZSTD=y in droidspace.config to enable.

Reconstructed and validated against e404 staging-bpf base.

--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -571,6 +571,7 @@
 	bool "Compressed cache for swap pages (EXPERIMENTAL)"
 	depends on FRONTSWAP && CRYPTO=y && !ZRAM
 	select CRYPTO_LZO
+	select CRYPTO_ZSTD if ZSWAP_COMPRESSOR_ZSTD
 	select ZPOOL
 	default n
 	help
@@ -587,6 +588,16 @@
 	  they have not be fully explored on the large set of potential
 	  configurations and workloads that exist.
 
+config ZSWAP_COMPRESSOR_ZSTD
+	bool "Use zstd as default zswap compressor"
+	depends on ZSWAP && CRYPTO_ZSTD
+	default n
+	help
+	  Use zstd instead of lzo as the default compressor for zswap.
+	  zstd provides better compression ratios at comparable decompression
+	  speed. Recommended for SM8250 (POCO F3).
+
+
 config ZPOOL
 	tristate "Common API for compressed memory storage"
 	default n
--- a/mm/zswap.c
+++ b/mm/zswap.c
@@ -91,7 +91,11 @@
 module_param_cb(enabled, &zswap_enabled_param_ops, &zswap_enabled, 0644);
 
 /* Crypto compressor to use */
+#ifdef CONFIG_ZSWAP_COMPRESSOR_ZSTD
+#define ZSWAP_COMPRESSOR_DEFAULT "zstd"
+#else
 #define ZSWAP_COMPRESSOR_DEFAULT "lzo"
+#endif
 static char *zswap_compressor = ZSWAP_COMPRESSOR_DEFAULT;
 static int zswap_compressor_param_set(const char *,
 				      const struct kernel_param *);
