--- a/drivers/misc/ntsync.c
+++ b/drivers/misc/ntsync.c
@@ -13,12 +13,15 @@
 #include <linux/ktime.h>
 #include <linux/miscdevice.h>
 #include <linux/module.h>
+#include <linux/mount.h>
 #include <linux/mutex.h>
+#include <linux/namei.h>
 #include <linux/overflow.h>
 #include <linux/sched.h>
 #include <linux/sched/signal.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
+#include <linux/workqueue.h>
 #include <uapi/linux/ntsync.h>
 
 #include <linux/uaccess.h>
@@ -1225,7 +1228,67 @@
 	.mode		= 0666,
 };
 
-module_misc_device(ntsync_misc);
+#define NTSYNC_DEV_PATH		"/dev/ntsync"
+#define NTSYNC_DEV_MODE		0666
+#define NTSYNC_PERM_INTERVAL	(5 * HZ)
+
+static struct delayed_work ntsync_perm_work;
+
+/*
+ * Android's ueventd overrides the mode of the device node to 0600 when there
+ * is no matching rule in ueventd.rc, clobbering the miscdevice .mode. Re-apply
+ * 0666 from the kernel so non-root Wine/Proton can open /dev/ntsync without
+ * relying on any userspace helper (this mirrors what the ntsync-perm KSU
+ * module does, but compiled in).
+ */
+static void ntsync_fix_perms(struct work_struct *work)
+{
+	struct path path;
+	struct file *file;
+	umode_t mode = 0;
+	int ret;
+
+	ret = kern_path(NTSYNC_DEV_PATH, LOOKUP_FOLLOW, &path);
+	if (ret)
+		goto reschedule;
+	mode = d_inode(path.dentry)->i_mode;
+	path_put(&path);
+
+	if ((mode & 07777) == NTSYNC_DEV_MODE)
+		goto reschedule;
+
+	file = filp_open(NTSYNC_DEV_PATH, O_PATH, 0);
+	if (!IS_ERR(file)) {
+		vfs_fchmod(file, NTSYNC_DEV_MODE);
+		filp_close(file, NULL);
+	}
+
+reschedule:
+	schedule_delayed_work(&ntsync_perm_work, NTSYNC_PERM_INTERVAL);
+}
+
+static int __init ntsync_init(void)
+{
+	int ret;
+
+	ret = misc_register(&ntsync_misc);
+	if (ret)
+		return ret;
+
+	INIT_DELAYED_WORK(&ntsync_perm_work, ntsync_fix_perms);
+	schedule_delayed_work(&ntsync_perm_work, NTSYNC_PERM_INTERVAL);
+
+	return 0;
+}
+
+static void __exit ntsync_exit(void)
+{
+	cancel_delayed_work_sync(&ntsync_perm_work);
+	misc_deregister(&ntsync_misc);
+}
+
+module_init(ntsync_init);
+module_exit(ntsync_exit);
 
 MODULE_AUTHOR("Elizabeth Figura <zfigura@codeweavers.com>");
 MODULE_DESCRIPTION("Kernel driver for NT synchronization primitives");
