From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pulsar Bot <pulsar@localhost>
Date: Fri, 07 Aug 2026 21:00:00 +0000
Subject: [PATCH 1/3] uapi: futex: add futex_waitv structures

Backport of futex_waitv UAPI from Linux 6.4.
The futex_waitv syscall (nr 449) lets a thread wait on an array
of futexes in a single syscall, avoiding N round-trips.
This is critical for Wine/Proton/Winlator via ntsync where
games create hundreds of synchronization objects.

Signed-off-by: Pulsar Bot <pulsar@localhost>
---
 include/uapi/linux/futex.h | 25 +++++++++++++++++++++++++

diff --git a/include/uapi/linux/futex.h b/include/uapi/linux/futex.h
--- a/include/uapi/linux/futex.h
+++ b/include/uapi/linux/futex.h
@@ -149,5 +149,30 @@
 #define FUTEX_OP(op, oparg, cmp, cmparg) \
   (((op & 0xf) << 28) | ((cmp & 0xf) << 24)		\
    | ((oparg & 0xfff) << 12) | (cmparg & 0xfff))
 
+/*
+ * futex_waitv - batch wait on multiple futexes
+ */
+
+/* Opcodes for futex_waitv.flags */
+#define FUTEX_32		2
+#define FUTEX_WAITV_MAX		128
+
+/**
+ * struct futex_waitv - A waiter for vectorized wait.
+ * @val:   Expected value at uaddr.
+ * @uaddr: User address to wait on.
+ * @flags: Flags for this waiter (FUTEX_32, FUTEX_PRIVATE_FLAG, etc.)
+ * @__reserved: Must be zero.
+ */
+struct futex_waitv {
+	__u64 val;
+	__u64 uaddr;
+	__u32 flags;
+	__u32 __reserved;
+};
+
+/* Flags for futex_waitv (passed as the top-level 'flags' arg) */
+#define FUTEX_WAITV_CLOCK_REALTIME	1
+
 #endif /* _UAPI_LINUX_FUTEX_H */
