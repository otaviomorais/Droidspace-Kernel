From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pulsar Bot <pulsar@localhost>
Date: Fri, 07 Aug 2026 21:00:00 +0000
Subject: [PATCH] mm/shmem: enforce F_SEAL_EXEC

Enforces the F_SEAL_EXEC seal created by memfd_create(MFD_NOEXEC_SEAL).
Without this, the seal exists but mmap() does not actually check it.

Signed-off-by: Pulsar Bot <pulsar@localhost>
---
 include/uapi/linux/fcntl.h | 1 +
 mm/shmem.c                 | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/include/uapi/linux/fcntl.h b/include/uapi/linux/fcntl.h
--- a/include/uapi/linux/fcntl.h
+++ b/include/uapi/linux/fcntl.h
@@ -43,6 +43,7 @@
 #define F_SEAL_SHRINK	0x0002	/* prevent file from shrinking */
 #define F_SEAL_GROW	0x0004	/* prevent file from growing */
 #define F_SEAL_WRITE	0x0008	/* prevent writes */
+#define F_SEAL_EXEC	0x0020	/* prevent executable mappings */
 /* (1U << 31) is reserved for signed error codes */
 
 /*
diff --git a/mm/shmem.c b/mm/shmem.c
--- a/mm/shmem.c
+++ b/mm/shmem.c
@@ -2188,6 +2188,11 @@
 	struct shmem_inode_info *info = SHMEM_I(inode);
 	int ret;
 
+	if (info->seals & F_SEAL_EXEC) {
+		if (vma->vm_flags & VM_EXEC)
+			return -EPERM;
+	}
+
 	ret = check_routed_dir(inode, file);
 	if (ret)
 		return ret;
