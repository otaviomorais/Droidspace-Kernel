Subject: [PATCH] fs: add task_fd_install() helper

Backport of task_fd_install() needed by the seccomp notify addfd
feature. This allows the supervisor to install a file descriptor
into the supervised task's fdtable.

--- a/include/linux/file.h
+++ b/include/linux/file.h
@@ -88,6 +88,7 @@
 extern void put_unused_fd(unsigned int fd);
 
 extern void fd_install(unsigned int fd, struct file *file);
+extern int task_fd_install(struct task_struct *task, unsigned int fd, struct file *file, unsigned int flags);
 
 extern void flush_delayed_fput(void);
 extern void flush_delayed_fput_wait(void);
--- a/fs/file.c
+++ b/fs/file.c
@@ -633,6 +633,29 @@
 
 EXPORT_SYMBOL(fd_install);
 
+int task_fd_install(struct task_struct *task, unsigned int fd, struct file *file, unsigned int flags)
+{
+	struct files_struct *files;
+	struct fdtable *fdt;
+
+	task_lock(task);
+	files = task->files;
+	if (files) {
+		spin_lock(&files->file_lock);
+		fdt = files_fdtable(files);
+		BUG_ON(fdt->fd[fd] != NULL);
+		rcu_assign_pointer(fdt->fd[fd], file);
+		if (flags & O_CLOEXEC)
+			__set_close_on_exec(fd, fdt);
+		else
+			__clear_close_on_exec(fd, fdt);
+		spin_unlock(&files->file_lock);
+	}
+	task_unlock(task);
+	return files ? 0 : -ESRCH;
+}
+EXPORT_SYMBOL(task_fd_install);
+
 static struct file *pick_file(struct files_struct *files, unsigned fd)
