--- a/kernel/seccomp.c
+++ b/kernel/seccomp.c
@@ -47,11 +47,35 @@
  * seccomp_filter objects should never be modified after being attached
  * to a task_struct (other than @usage).
  */
 struct seccomp_filter {
 	refcount_t usage;
 	bool log;
 	struct seccomp_filter *prev;
 	struct bpf_prog *prog;
+	struct notification *notif;
+	struct mutex notify_lock;
+};
+
+/**
+ * struct seccomp_knotif - kernel-internal seccomp notification state
+ * @task: the task that triggered the notification
+ * @id: unique notification id
+ * @data: the seccomp_data for the syscall that triggered the notification
+ * @state: state of this notification
+ * @error: error from the supervisor (valid when state == SECCOMP_NOTIFY_REPLIED)
+ * @val: return value from the supervisor
+ * @flags: SECCOMP_USER_NOTIF_FLAG_* flags
+ * @list: member in notification object's list
+ * @wait: poll/wait for notification completion
+ */
+enum notify_state {
+	SECCOMP_NOTIFY_INIT,
+	SECCOMP_NOTIFY_SENT,
+	SECCOMP_NOTIFY_REPLIED,
+};
+
+struct seccomp_knotif {
+	struct task_struct *task;
+	u64 id;
+	const struct seccomp_data *data;
+	enum notify_state state;
+	int error;
+	long val;
+	u32 flags;
+	struct list_head list;
+	struct completion ready;
 };
 
+struct notification {
+	struct semaphore request;
+	u64 next_id;
+	struct list_head notifications;
+	wait_queue_head_t wqh;
+};
+
